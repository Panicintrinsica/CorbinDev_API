# --- Database -----------------------------------------------------------------
DB_USER=
DB_PASS=
DB_CLUSTER=

# --- Uploaded media -----------------------------------------------------------
# Where uploaded images are written. Mount a volume here in production: the files
# are the only state this container holds that is not in Atlas, and they are gone
# with the container otherwise.
MEDIA_DIR=./media
# Per-file upload ceiling in bytes. Default 10MB.
MEDIA_MAX_BYTES=8388608
# Origin that stored image URLs are built from. Local storage: the API, e.g.
# https://api.corbin.dev (blank falls back to the request origin, fine for dev).
# Object storage: REQUIRED, the public bucket's custom domain, no trailing slash,
# e.g. https://img.corbin.dev
MEDIA_BASE_URL=

# Cloudflare R2 (any S3-compatible store works). Setting STORAGE_PUBLIC_BUCKET
# switches uploads from MEDIA_DIR to object storage; leave all of these blank for
# local-disk storage.
#
# Two buckets, because R2 has no per-object ACLs and public access is per bucket:
#   public  holds the served variants; attach MEDIA_BASE_URL to it as a custom domain
#   private holds the as-uploaded originals; never give it a public domain or r2.dev URL
STORAGE_PUBLIC_BUCKET=
STORAGE_PRIVATE_BUCKET=
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com (add .eu. / .us. for a jurisdiction)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
# R2 > Manage API Tokens > "Object Read & Write", limited to the two buckets above.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Uploads nothing references are deleted after this many hours. Must comfortably
# exceed how long an article draft stays open: Editor.js uploads images before the
# article is first saved.
MEDIA_ORPHAN_GRACE_HOURS=24
MEDIA_SWEEP_INTERVAL_HOURS=6
# Set to "off" to disable the background sweep (e.g. on all but one replica).
# MEDIA_SWEEP=off

# --- Hades authentication -----------------------------------------------------
# Base URL of the Hades service, no trailing slash. This is the default; set it
# only to point at a local or staging Hades.
HADES_BASE_URL=https://auth.impetusstudios.com
# Hex (or PEM) Ed25519 public key — Hades' PASETO_PUBLIC_KEY. Required.
HADES_PASETO_PUBLIC_KEY=

# The client/realm this API belongs to. REQUIRED: the gateway stamps them onto
# every forwarded credential call, and they also become the default token
# allow-lists, so tokens minted for another client are rejected.
HADES_CLIENT_ID=
HADES_REALM_ID=
# Override the allow-lists explicitly if this API serves more than one.
# HADES_ALLOWED_REALMS=realm-a,realm-b
# HADES_ALLOWED_CLIENTS=client-a,client-b

# Scoped client key for POST /internal/validate-session.
# Required unless HADES_SESSION_VALIDATION=off.
HADES_CLIENT_API_KEY=
# "required" (default) or "off". "off" means a logout or ban is only honoured
# once a webhook arrives, and an access token stays usable for its full TTL.
HADES_SESSION_VALIDATION=required
# "closed" (default) or "open". Whether a Hades outage 503s or degrades to
# signature-only verification.
HADES_ON_VALIDATOR_ERROR=closed
HADES_SESSION_CACHE_TTL_SECONDS=60
HADES_SESSION_NEGATIVE_CACHE_TTL_SECONDS=30
HADES_SESSION_TIMEOUT_MS=3000
HADES_CLOCK_SKEW_SECONDS=30

# Security webhook receiver (mounted at /hooks/hades). The secret is returned
# once by PUT /admin/clients/{client_id}/webhook and never readable again.
HADES_WEBHOOK_SECRET=
HADES_WEBHOOK_TOLERANCE_SECONDS=300

# --- Local authorization ------------------------------------------------------
# Roles given to a principal on first sight when no role is marked isDefault.
AUTH_DEFAULT_ROLES=member
AUTH_AUTO_PROVISION=true
AUTH_ROLE_CACHE_TTL_SECONDS=60

# --- Account and gateway (Charon contract) ------------------------------------
# Name reported by GET /auth/meta, shown by hades-ng as the site name.
AUTH_DOMAIN_NAME=corbin.dev
# Social providers enabled in Hades for this client, reported by /auth/meta.
# AUTH_SOCIAL_PROVIDERS=discord,twitch
# New accounts get a placeholder display name "<prefix>#<id>" until they choose one.
AUTH_DISPLAY_NAME_PREFIX=Vanguard
# Reverse proxies in front of this API (addresses or CIDR ranges). The gateway forwards
# the caller address to Hades, which rate-limits by it; X-Forwarded-For is believed
# only when the connection comes from one of these. Leave empty only if nothing sits in
# front of the API: otherwise every visitor shares the proxy rate-limit bucket.
# Hades needs this API address in its own TRUSTED_PROXIES for the same reason.
AUTH_TRUSTED_PROXIES=

# Optional: pin the site's single Profile page to this Hades user id. Left blank, it
# belongs to the first account that saves it, and no other account can then edit it.
BIO_PROFILE_USER_ID=
