# --- Database -----------------------------------------------------------------
DB_USER=
DB_PASS=
DB_CLUSTER=

# --- Uploaded media -----------------------------------------------------------
# Where uploaded images are written. Mount a volume here in production: the files
# are the only state this container holds that is not in Atlas, and they are gone
# with the container otherwise.
MEDIA_DIR=./media
# Per-file upload ceiling in bytes. Default 8MB.
MEDIA_MAX_BYTES=8388608
# Origin that stored image URLs are built from, e.g. https://api.corbin.dev. Left
# blank, the upload route falls back to the origin the request arrived on, which
# is what local development wants and what production should not rely on.
MEDIA_BASE_URL=

# --- Hades authentication -----------------------------------------------------
# Base URL of the Hades service, no trailing slash. This is the default; set it
# only to point at a local or staging Hades.
HADES_BASE_URL=https://auth.impetusstudios.com
# Hex (or PEM) Ed25519 public key — Hades' PASETO_PUBLIC_KEY. Required.
HADES_PASETO_PUBLIC_KEY=

# The client/realm this API belongs to. REQUIRED: the gateway stamps them onto
# every forwarded credential call, and they also become the default token
# allow-lists, so tokens minted for another client are rejected.
HADES_CLIENT_ID=
HADES_REALM_ID=
# Override the allow-lists explicitly if this API serves more than one.
# HADES_ALLOWED_REALMS=realm-a,realm-b
# HADES_ALLOWED_CLIENTS=client-a,client-b

# Shared key for POST /internal/validate-session — Hades' INTERNAL_API_KEY.
# Required unless HADES_SESSION_VALIDATION=off.
HADES_INTERNAL_API_KEY=
# "required" (default) or "off". "off" means a logout or ban is only honoured
# once a webhook arrives, and an access token stays usable for its full TTL.
HADES_SESSION_VALIDATION=required
# "closed" (default) or "open". Whether a Hades outage 503s or degrades to
# signature-only verification.
HADES_ON_VALIDATOR_ERROR=closed
HADES_SESSION_CACHE_TTL_SECONDS=60
HADES_SESSION_NEGATIVE_CACHE_TTL_SECONDS=30
HADES_SESSION_TIMEOUT_MS=3000
HADES_CLOCK_SKEW_SECONDS=30

# Security webhook receiver (mounted at /hooks/hades). The secret is returned
# once by PUT /admin/clients/{client_id}/webhook and never readable again.
HADES_WEBHOOK_SECRET=
HADES_WEBHOOK_TOLERANCE_SECONDS=300

# --- Local authorization ------------------------------------------------------
# Roles given to a principal on first sight when no role is marked isDefault.
AUTH_DEFAULT_ROLES=member
AUTH_AUTO_PROVISION=true
AUTH_ROLE_CACHE_TTL_SECONDS=60
